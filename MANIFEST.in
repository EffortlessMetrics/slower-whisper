# MANIFEST.in - source distribution file selection for setuptools

# Core project metadata
include README.md
include LICENSE-APACHE
include LICENSE-MIT
include CHANGELOG.md
include CITATION.cff
include CONTRIBUTING.md
include SECURITY.md
include ROADMAP.md
include CLAUDE.md
include AGENTS.md
include THIRD_PARTY_NOTICES.md

# Packaging/build metadata
include pyproject.toml
include MANIFEST.in
include uv.lock
include flake.nix
include flake.lock
include Makefile
include pytest.ini
include pyrightconfig.json
include .pre-commit-config.yaml

# Dependency pins
include requirements.txt
include requirements-base.txt
include requirements-enrich.txt
include requirements-dev.txt

# Runtime package data
include transcription/py.typed
include slower_whisper/py.typed
recursive-include transcription/schemas *.json *.md

# Exclude compiled/temporary artifacts
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
global-exclude *.swp
global-exclude *.swo

# Exclude build and local output directories
prune build
prune dist
prune *.egg-info
prune docs/_build
prune benchmarks/results
prune benchmarks/test_audio
prune htmlcov
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache
prune .benchmarks

# Exclude local data directories created at runtime
prune raw_audio
prune input_audio
prune transcripts
prune whisper_json

# Exclude virtual environments and repository-only surfaces
prune venv
prune env
prune .venv
prune tests
prune config
prune k8s
prune .github
prune benchmarks
prune examples
prune docs
prune scripts
prune integrations
prune transcription/historian
